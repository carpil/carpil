{
  "indexes": [
    {
      "collectionGroup": "driver_applications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "userId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "trip_requests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "origin.geohash", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "recurring_routes",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "activeMode.enabled", "order": "ASCENDING" },
        { "fieldPath": "origin.geohash", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "offers",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "driverId", "order": "ASCENDING" },
        { "fieldPath": "outcome", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "rides",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "passengerIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "members",
      "fieldPath": "uid",
      "indexes": [
        { "queryScope": "COLLECTION_GROUP", "order": "ASCENDING" }
      ]
    }
  ]
}
