rules_version = '2';

// The API and Functions use the Admin SDK, which bypasses these rules. Everything here
// describes what the mobile client may do directly, which is almost nothing: the API owns
// every write except marking a chat message as seen.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The ride screen listens to one ride doc. Listing stays closed so a signed-in client
    // can't bulk-scrape every route (V4).
    match /rides/{rideId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // verification.*, isDriver and role gate privileged API actions, so the client must
    // never write this doc (V2). The app only listens to its own.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{messageId} {
        function isParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        // Released app versions overwrite seenBy with a stale copy plus their own uid, so
        // a concurrent reader's uid can drop out. Rejecting that would hide the message on
        // screen, so the rule only checks that the caller adds nobody but themselves and
        // stays in the list.
        function isMarkingSeen() {
          let stored = resource.data.get('seenBy', []);
          let before = stored == null ? [] : stored;
          let after = request.resource.data.get('seenBy', null);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && after is list
            && request.auth.uid in after
            && after.size() <= before.size() + 1
            && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid]);
        }

        allow read: if isParticipant();
        allow update: if isParticipant() && isMarkingSeen();
        allow create, delete: if false;
      }
    }

    // driver_applications, ride-requests, trip_requests, vehicles, payments, ratings and
    // every other collection are API-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
