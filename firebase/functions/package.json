{
  "name": "carpil-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Cloud Functions for Carpil (scheduled jobs, retention, ride lifecycle).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm build && firebase emulators:start --only functions,firestore",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "expo-server-sdk": "^6.1.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
