rules_version = '2';

// One bucket serves dev, staging and prod, and Storage rules can only read the (default)
// Firestore database, so nothing here may depend on Firestore documents.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A SINPE receipt shows the payer's name, phone and amount (V9). Only the uploader
    // reads it through the SDK; the API keeps the tokenized download URL on the payment.
    match /rides/{rideId}/sinpe-payments/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Public read so the URL stored on the user renders for any viewer (rides, chat, profile).
    match /users/{userId}/profile.jpg {
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
