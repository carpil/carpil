rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Passengers upload SINPE mobile payment receipts for a ride.
    // Only the uploader can write; any authenticated user can read (driver needs to verify).
    match /rides/{rideId}/sinpe-payments/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Profile picture (one canonical object per user). Owner-only write, public read
    // so the URL stored in Firestore renders for any viewer (rides, chat, profile).
    match /users/{userId}/profile.jpg {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Deny all other paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
